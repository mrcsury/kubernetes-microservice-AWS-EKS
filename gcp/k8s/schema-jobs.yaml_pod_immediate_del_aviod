apiVersion: batch/v1
kind: Job
metadata:
  name: prisma-push-auth
  namespace: blog
spec:
  backoffLimit: 0
  ttlSecondsAfterFinished: 3600
  template:
    spec:
      restartPolicy: Never
      containers:
        - name: prisma-push
          image: asia-south1-docker.pkg.dev/project-5d14303c-195f-4cf8-8be/blog-auth-service/blog-auth-service:latest
          command: ["npx", "prisma", "db", "push", "--skip-generate"]
          env:
            - name: DATABASE_URL
              valueFrom:
                secretKeyRef:
                  name: blog-secrets
                  key: db-auth-url
